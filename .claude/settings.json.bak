{
  "$schema": "https://cdn.jsdelivr.net/gh/veniamin/proben.io/.claude/settings-schema.json",
  "permissions": {
    "allowed": [
      {
        "tool": "Bash",
        "prompt": "Run npm/pnpm commands",
        "commands": ["pnpm *", "npm *", "git *", "node *"]
      },
      {
        "tool": "Bash",
        "prompt": "Run Prisma database commands",
        "commands": ["pnpm prisma *"]
      },
      {
        "tool": "Bash",
        "prompt": "Run tests and quality checks",
        "commands": ["pnpm test", "pnpm test:*", "pnpm lint", "pnpm type-check"]
      },
      {
        "tool": "Read",
        "prompt": "Read project files"
      },
      {
        "tool": "Edit",
        "prompt": "Edit project files"
      },
      {
        "tool": "Write",
        "prompt": "Write new files"
      }
    ],
    "denied": [
      {
        "tool": "Bash",
        "prompt": "Run package managers without auto-confirmation",
        "commands": ["pnpm install", "pnpm add", "npm install", "npm add"]
      },
      {
        "tool": "Bash",
        "prompt": "Run git push to remote",
        "commands": ["git push"]
      }
    ]
  },
  "hooks": {
    "session": {
      "on-start": {
        "command": "bash",
        "args": [
          "-c",
          "mkdir -p .claude/logs && echo \"Session started: $(date -Iseconds)\" >> .claude/logs/session.log"
        ]
      },
      "on-end": {
        "command": "bash",
        "args": [
          "-c",
          "echo \"Session ended: $(date -Iseconds)\" >> .claude/logs/session.log"
        ]
      }
    },
    "tool": {
      "pre-edit": {
        "command": "bash",
        "args": [
          "-c",
          "if [ -n \"$FILE_PATH\" ]; then echo \"Editing: $FILE_PATH\" >> .claude/logs/edit.log; fi"
        ],
        "env": {
          "FILE_PATH": "${file_path}"
        }
      }
    }
  },
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/veniamin/Projects/proben.io"
      ]
    }
  },
  "skills": {
    "enabled": [
      "security-review",
      "research-digest",
      "prompt-optimization",
      "request-intake",
      "release-check"
    ]
  },
  "environment": {
    "NODE_VERSION": "20",
    "PACKAGE_MANAGER": "pnpm"
  }
}
